{
  "name": "@scios/meta-recovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "run": "tsx src/cli.ts",
    "dry-run": "tsx src/cli.ts --dry-run",
    "fault-test": "tsx src/cli.ts --fault-test",
    "resume": "tsx src/cli.ts --resume"
  },
  "dependencies": {
    "@scios/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
