{
  "name": "scios-alpha",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/**\" run dev",
    "dev:alpha": "pnpm --filter @scios/alpha-loop start",
    "sim": "pnpm --filter @scios/alpha-loop sim",
    "check": "pnpm --filter @scios/alpha-loop check",
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" --if-present run typecheck",
    "test": "pnpm --filter @scios/data-fabric test && pnpm --filter @scios/vertical-slice test",
    "demo": "pnpm --filter @scios/control-plane-api demo",
    "mock:dev": "pnpm --filter @scios/mock-api dev",
    "mock:build": "pnpm build && pnpm --filter @scios/mock-api build",
    "mock:start": "pnpm --filter @scios/mock-api start",
    "mock:start:dist": "pnpm --filter @scios/mock-api start:dist",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up --build",
    "docker:local": "docker compose -f infra/docker/docker-compose.infra.yml up -d",
    "docker:local:down": "docker compose -f infra/docker/docker-compose.infra.yml down",
    "docker:local:ps": "docker compose -f infra/docker/docker-compose.infra.yml ps",
    "gate:scaffold": "node scripts/gate-scaffold.mjs",
    "gate:contracts": "node scripts/gate-contracts.mjs",
    "gate:foundation": "node scripts/gate-foundation.mjs",
    "ci:prediction-foundation-gate": "node scripts/ci-prediction-foundation-gate.mjs",
    "boot": "node scripts/boot/index.mjs",
    "boot:normal": "node scripts/boot/index.mjs normal",
    "boot:repair": "node scripts/boot/index.mjs repair",
    "boot:safe": "node scripts/boot/index.mjs safe",
    "boot:proof": "node scripts/boot/index.mjs proof",
    "start": "node installer/scripts/start-sci-os.cjs --mode=normal",
    "sci:start": "node installer/scripts/bootstrap-capsule.cjs --serve",
    "sci:stop": "node installer/scripts/convergence/stop.cjs",
    "sci:restart": "node installer/scripts/convergence/stop.cjs && node installer/scripts/bootstrap-capsule.cjs --serve",
    "sci:status": "node installer/scripts/convergence/status.cjs",
    "sci:proof": "node installer/scripts/convergence/startup-proof.cjs",
    "ci:startup-convergence-gate": "node installer/scripts/convergence/convergence-gate.cjs",
    "sci:desktop": "node installer/scripts/bootstrap-capsule.cjs --serve",
    "sci:shutdown": "node installer/scripts/convergence/stop.cjs --infra",
    "sci:repair": "node installer/scripts/repair-sci-os.cjs",
    "sci:meta-recovery": "pnpm --filter @scios/meta-recovery run run",
    "sci:meta-recovery:dry-run": "pnpm --filter @scios/meta-recovery run dry-run",
    "sci:meta-recovery:prove": "pnpm --filter @scios/meta-recovery run prove",
    "sci:meta-recovery:fault-test": "pnpm --filter @scios/meta-recovery exec tsx src/cli.ts --fault-test",
    "sci:meta-recovery:resume": "pnpm --filter @scios/meta-recovery exec tsx src/cli.ts --resume",
    "sci:capability-scan": "pnpm --filter @scios/meta-recovery exec tsx src/cli.ts --dry-run",
    "sci:dependency-graph": "pnpm --filter @scios/meta-recovery exec tsx src/cli.ts --dry-run",
    "sci:repair-recipes": "node -e \"console.log(require('fs').readFileSync('docs/enterprise/REPAIR_RECIPE_CATALOG.md','utf8'))\"",
    "sci:recovery-memory": "node -e \"const p=require('path').join('diagnostics-export','meta-recovery','recovery-memory.json');console.log(require('fs').existsSync(p)?require('fs').readFileSync(p,'utf8'):'{}')\"",
    "sci:recovery-shell": "pnpm --filter @scios/meta-recovery-control-plane start",
    "sci:x10": "node installer/scripts/sci-os-x10-launcher.cjs",
    "sci:bootstrap": "node installer/scripts/bootstrap-kernel.cjs",
    "orchestrator:discover": "node scripts/discovery.js",
    "orchestrator:filter": "node scripts/filter.js",
    "orchestrator:clone": "node scripts/clone.js",
    "orchestrator:scan": "node scripts/scan.js",
    "orchestrator:scaffold": "node scripts/scaffold-adapter.js",
    "orchestrator:gen-tests": "node scripts/gen-tests.js",
    "orchestrator:all": "pnpm orchestrator:discover && pnpm orchestrator:filter && pnpm orchestrator:clone && pnpm orchestrator:scan && pnpm orchestrator:scaffold && pnpm orchestrator:gen-tests",
    "install:repro": "pnpm install --frozen-lockfile"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
