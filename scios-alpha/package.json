{
  "name": "sci-os-x10",
  "private": true,
  "description": "SCI OS ×10 ALPHA — workspace root (local-foundation). Folder: scios-alpha/",
  "packageManager": "pnpm@9.15.0",
  "bin": "scripts/pkg-entry.cjs",
  "pkg": {
    "scripts": [
      "scripts/pkg-entry.cjs",
      "bootstrap/bootstrap-capsule.js"
    ],
    "assets": [
      "bootstrap/boot-manifest.json",
      "installer/golden-boot.manifest.json",
      "installer/schemas/golden-boot-manifest.schema.json",
      "sci-os.manifest.json",
      "package.json"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "backend": "pnpm --filter @scios/control-plane-api start",
    "cockpit": "pnpm --filter @scios/cockpit-ui start",
    "dev": "pnpm -r --parallel --filter \"./apps/**\" run dev",
    "dev:alpha": "pnpm --filter @scios/alpha-loop start",
    "dev:mock": "pnpm --filter @scios/mock-api dev",
    "sim": "pnpm --filter @scios/alpha-loop sim",
    "check": "pnpm --filter @scios/alpha-loop check",
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "build:release": "pnpm -r --filter \"./packages/**\" --if-present run build && pnpm -r --filter \"./apps/control-plane-api\" --filter \"./apps/cockpit-ui\" --if-present run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" --if-present run typecheck",
    "test": "pnpm --filter @scios/data-fabric test && pnpm --filter @scios/vertical-slice test",
    "test:product-smoke": "node scripts/smoke-vertical-slice.js",
    "test:cockpit-script": "node scripts/tests/cockpit-generated-script.cjs",
    "test:cockpit-birth": "node scripts/tests/cockpit-birth-test.cjs",
    "test:cockpit-e2e": "node scripts/tests/cockpit-birth-e2e.cjs",
    "test:exit-contract": "node scripts/tests/exit-contract.test.cjs",
    "test:alpha": "node scripts/tests/alpha-readiness.cjs",
    "test:alpha-convergence": "node scripts/tests/alpha-product-convergence.cjs",
    "test:release": "node scripts/tests/cockpit-generated-script.cjs && node scripts/tests/cockpit-birth-test.cjs && node scripts/tests/exit-contract.test.cjs && node scripts/tests/correlation-ids.cjs && node scripts/tests/runtime-security-path.cjs && node scripts/tests/privacy-safe-logs.cjs && node scripts/tests/first-release-resilience.cjs && node scripts/tests/cockpit-output-encoding.cjs && node scripts/tests/default-yaml-optional.cjs && node scripts/tests/action-chain-honesty.cjs && node scripts/tests/completion-wiring.cjs && node scripts/tests/block2-experience-proof.cjs && node scripts/tests/experience-compiler-matrix.cjs && node scripts/tests/alpha-product-convergence.cjs && node scripts/tests/cf11-job-states.cjs && node scripts/tests/cf11-b002-hard-gate.cjs && node scripts/tests/cf14-policy-unit.cjs && node scripts/tests/cf14-policy-enforcement.cjs && node scripts/tests/cf14-b003-hard-gate.cjs && node scripts/tests/b004-persistence-hard-gate.cjs && node scripts/tests/whi-001-job-object.cjs && node scripts/tests/whi-011-host-digital-twin.cjs && node scripts/tests/whi-010-recovery-intelligence.cjs && node scripts/tests/whi-004-host-event-provider.cjs",
    "release-contracts": "pnpm test:release",
    "demo": "pnpm --filter @scios/control-plane-api demo",
    "mock:dev": "pnpm --filter @scios/mock-api dev",
    "mock:build": "pnpm build && pnpm --filter @scios/mock-api build",
    "mock:start": "pnpm --filter @scios/mock-api start",
    "mock:start:dist": "pnpm --filter @scios/mock-api start:dist",
    "start": "node installer/scripts/start-sci-os.cjs --mode=normal",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up --build",
    "docker:local": "docker compose -f infra/docker/docker-compose.infra.yml up -d",
    "docker:local:down": "docker compose -f infra/docker/docker-compose.infra.yml down",
    "docker:local:ps": "docker compose -f infra/docker/docker-compose.infra.yml ps",
    "gate:scaffold": "node scripts/gate-scaffold.mjs",
    "gate:contracts": "node scripts/gate-contracts.mjs",
    "gate:foundation": "node scripts/gate-foundation.mjs",
    "ci:prediction-foundation-gate": "node scripts/ci-prediction-foundation-gate.mjs",
    "boot": "node scripts/boot/index.mjs",
    "boot:normal": "node scripts/boot/index.mjs normal",
    "boot:repair": "node scripts/boot/index.mjs repair",
    "boot:safe": "node scripts/boot/index.mjs safe",
    "boot:proof": "node scripts/boot/index.mjs proof",
    "sci:start": "node installer/scripts/bootstrap-capsule.cjs --serve",
    "sci:stop": "node installer/scripts/convergence/stop.cjs",
    "sci:restart": "node installer/scripts/convergence/stop.cjs && node installer/scripts/bootstrap-capsule.cjs --serve",
    "sci:status": "node installer/scripts/convergence/status.cjs",
    "sci:proof": "node installer/scripts/convergence/startup-proof.cjs",
    "ci:startup-convergence-gate": "node installer/scripts/convergence/convergence-gate.cjs",
    "sci:desktop": "node installer/scripts/bootstrap-capsule.cjs --serve",
    "sci:shutdown": "node installer/scripts/convergence/stop.cjs --infra",
    "sci:repair": "node installer/scripts/repair-sci-os.cjs",
    "sci:meta-recovery": "pnpm --filter @scios/meta-recovery run run",
    "sci:meta-recovery:dry-run": "pnpm --filter @scios/meta-recovery run dry-run",
    "sci:meta-recovery:prove": "pnpm --filter @scios/meta-recovery run prove",
    "sci:meta-recovery:fault-test": "pnpm --filter @scios/meta-recovery exec tsx src/cli.ts --fault-test",
    "sci:meta-recovery:resume": "pnpm --filter @scios/meta-recovery exec tsx src/cli.ts --resume",
    "sci:capability-scan": "pnpm --filter @scios/meta-recovery exec tsx src/cli.ts --dry-run",
    "sci:dependency-graph": "pnpm --filter @scios/meta-recovery exec tsx src/cli.ts --dry-run",
    "sci:repair-recipes": "node -e \"console.log(require('fs').readFileSync('docs/enterprise/REPAIR_RECIPE_CATALOG.md','utf8'))\"",
    "sci:recovery-memory": "node -e \"const p=require('path').join('diagnostics-export','meta-recovery','recovery-memory.json');console.log(require('fs').existsSync(p)?require('fs').readFileSync(p,'utf8'):'{}')\"",
    "sci:recovery-shell": "pnpm --filter @scios/meta-recovery-control-plane start",
    "sci:x10": "node installer/scripts/sci-os-x10-launcher.cjs",
    "sci:bootstrap": "node installer/scripts/bootstrap-kernel.cjs",
    "orchestrator:discover": "node scripts/discovery.js",
    "orchestrator:filter": "node scripts/filter.js",
    "orchestrator:clone": "node scripts/clone.js",
    "orchestrator:scan": "node scripts/scan.js",
    "orchestrator:scaffold": "node scripts/scaffold-adapter.js",
    "orchestrator:gen-tests": "node scripts/gen-tests.js",
    "orchestrator:all": "pnpm orchestrator:discover && pnpm orchestrator:filter && pnpm orchestrator:clone && pnpm orchestrator:scan && pnpm orchestrator:scaffold && pnpm orchestrator:gen-tests",
    "signoff:generate": "node scripts/generate-signoff.js",
    "build:manifest": "node scripts/generate-build-manifest.js",
    "build:golden-boot": "node scripts/generate-golden-boot-manifest.js",
    "bootstrap:golden": "node bootstrap/bootstrap-capsule.js",
    "bootstrap:golden:dry": "node bootstrap/bootstrap-capsule.js --dry-run",
    "supervisor": "node supervisor/supervisor.js",
    "fault:inject": "node scripts/fault-injection-harness.js",
    "smoke:slice": "node scripts/smoke-vertical-slice.js",
    "auto:fill": "node -e \"console.error('OFF_PATH: auto:fill is scaffold-only; not boot authority'); process.exit(2)\"",
    "auto:fill:apply": "node -e \"console.error('OFF_PATH: auto:fill rejected'); process.exit(2)\"",
    "auto:fill:python": "node -e \"console.error('OFF_PATH: auto:fill rejected'); process.exit(2)\"",
    "auto:fill:sh": "node -e \"console.error('OFF_PATH: auto:fill rejected'); process.exit(2)\"",
    "generator:py": "python dev/generator.py --manifest build/manifest.json --templates dev/templates --plan dev/fill-plan.json",
    "generator:py:todos": "python dev/generator.py --manifest build/manifest.json --templates dev/templates --plan dev/fill-plan.json --scan-todos",
    "auto:finish": "node -e \"console.error('OFF_PATH: auto:finish is scaffold-only'); process.exit(2)\"",
    "auto:finish:gates": "node -e \"console.error('OFF_PATH: auto:finish rejected'); process.exit(2)\"",
    "auto:finish:todos": "node -e \"console.error('OFF_PATH: auto:finish rejected'); process.exit(2)\"",
    "auto:finish:apply": "node -e \"console.error('OFF_PATH: auto:finish rejected'); process.exit(2)\"",
    "ux:benchmark": "node -e \"const fs=require('fs');const p='diagnostics-export/ux-competitive-benchmark.json';if(!fs.existsSync(p)){console.error('MISSING '+p);process.exit(1)}console.log(JSON.stringify({ok:true,path:p,competitors:JSON.parse(fs.readFileSync(p,'utf8')).competitors.length},null,2))\"",
    "ux:proof": "node scripts/ux-usability-proof.js",
    "ux:truth": "node -e \"const fs=require('fs');const p='diagnostics-export/ux/current-ux-inventory.json';const d='docs/ux/CURRENT_UX_TRUTH.md';if(!fs.existsSync(p)||!fs.existsSync(d)){console.error('MISSING truth artifacts');process.exit(1)}console.log(JSON.stringify({ok:true,inventory:p,doc:d,verdict:JSON.parse(fs.readFileSync(p,'utf8')).foundationVerdict},null,2))\"",
    "ux:domains": "pnpm --filter @scios/professional-domain-registry check",
    "ux:compile:demo": "pnpm --filter @scios/professional-domain-registry compile:demo",
    "ux:kernel": "node -e \"const p='diagnostics-export/ux/product-kernel.json';const k='diagnostics-export/ux/kernel-pillars.json';const j=require('./'+p);const x=require('./'+k);console.log(JSON.stringify({ok:true,verdict:j.verdict,registryCaps:j.counts.capabilitiesInRegistryNow,pillars:x.pillars.map(t=>t.id+':'+t.status),path:p},null,2))\"",
    "closure:scan": "pnpm --filter @scios/system-closure run scan",
    "closure:p0": "pnpm --filter @scios/system-closure run p0",
    "closure:final": "pnpm --filter @scios/system-closure run final",
    "closure:startup": "pnpm --filter @scios/system-closure run startup-reconcile",
    "closure:continuous": "pnpm --filter @scios/system-closure run continuous",
    "closure:engine": "pnpm --filter @scios/system-closure run continuous",
    "kernel:export": "pnpm --filter @scios/product-kernel run export",
    "package:exe": "pnpm build && node scripts/generate-build-manifest.js && pnpm exec pkg . --targets node20-win-x64 --output dist/SCI-OS-X10.exe",
    "package:dist": "node scripts/package/build-distribution.cjs",
    "package:install": "node scripts/package/atomic-install.cjs",
    "reboot:pre": "node scripts/package/reboot-certification.cjs --pre",
    "reboot:post": "node scripts/package/reboot-cert-post.cjs",
    "package:reboot-prep": "node scripts/package/final-reboot-prep.cjs",
    "package:prove-reboot": "node scripts/package/prove-reboot.cjs",
    "release:reconcile": "node scripts/package/release-reconciliation.cjs",
    "truth:reconcile": "node scripts/truth-reconciliation.cjs",
    "gap:zero": "node scripts/gap-to-zero.cjs",
    "enterprise:discipline": "node scripts/enterprise-discipline.cjs",
    "crown:complete": "node scripts/crown-architecture.cjs",
    "ux:dna": "node scripts/ux-dna-lock.cjs",
    "agent:harness": "node scripts/agent-harness-preflight.cjs",
    "foundations:audit": "node scripts/foundations-audit.cjs",
    "integrity:run": "node scripts/integrity-run.cjs",
    "integrity:preflight": "node scripts/runtime-preflight.cjs",
    "deep:forensics": "node scripts/deep-forensics.cjs",
    "atom:ai": "node -e \"console.error('STALE: ATOM-AI rejected as parallel canonical product'); process.exit(2)\"",
    "atom:ai:gates": "node -e \"console.error('STALE: ATOM-AI rejected'); process.exit(2)\"",
    "atom:ai:todos": "node -e \"console.error('STALE: ATOM-AI rejected'); process.exit(2)\"",
    "atom:ai:apply": "node -e \"console.error('STALE: ATOM-AI rejected'); process.exit(2)\"",
    "atom:health": "node -e \"console.error('STALE: ATOM-AI health rejected'); process.exit(2)\"",
    "atom:health:repair": "node -e \"console.error('STALE: ATOM-AI health rejected'); process.exit(2)\"",
    "install:repro": "pnpm install --frozen-lockfile"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "pkg": "^5.8.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.18.0 <21",
    "pnpm": ">=8.0.0"
  }
}
