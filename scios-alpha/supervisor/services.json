{
  "backend": {
    "command": "pnpm",
    "args": ["run", "backend"],
    "note": "package.json script \"backend\" → control-plane-api"
  },
  "cockpit": {
    "command": "pnpm",
    "args": ["run", "cockpit"],
    "note": "package.json script \"cockpit\" → cockpit-ui"
  },
  "mock-api": {
    "command": "pnpm",
