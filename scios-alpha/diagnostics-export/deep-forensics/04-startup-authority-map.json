      "entry": "SCI-OS-Start.bat",
      "class": "CANONICAL_DEVELOPMENT",
      "target": "bootstrap-capsule.cjs"
    },
    {
      "entry": "pnpm sci:start",
      "class": "CANONICAL_DEVELOPMENT",
      "target": "bootstrap-capsule.cjs"
    },
    {
      "entry": "pnpm start",
      "class": "ALIAS",
      "target": "start-sci-os.cjs --mode=normal"
    },
    {
