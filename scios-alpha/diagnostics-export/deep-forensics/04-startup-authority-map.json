      "class": "CANONICAL_PRODUCTION",
      "target": "start-sci-os.cjs --packaged"
    },
    {
      "entry": "SCI-OS-Repair.bat",
      "class": "CANONICAL_RECOVERY",
      "target": "repair-sci-os + start-sci-os repair"
    },
    {
      "entry": "SCI-OS-Safe-Mode.bat",
      "class": "CANONICAL_RECOVERY",
      "target": "start-sci-os --mode=safe"
