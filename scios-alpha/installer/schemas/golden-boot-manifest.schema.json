{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scios.local/schemas/golden-boot-manifest.json",
  "title": "Golden Boot Manifest",
  "type": "object",
  "required": ["version", "buildSHA", "services", "ports", "healthChecks"],
  "properties": {
    "version": { "type": "string" },
    "buildSHA": { "type": "string" },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "entry", "args", "healthEndpoint"],
        "properties": {
          "name": { "type": "string" },
          "entry": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "healthEndpoint": { "type": "string" },
          "expectedStatus": { "type": "string", "default": "READY" }
        },
        "additionalProperties": true
      }
    },
    "ports": { "type": "object" },
    "healthChecks": { "type": "array", "items": { "type": "string" } },
    "fileHashes": { "type": "object" }
  },
  "additionalProperties": true
}
